<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_qrbase_report_wizard_form" model="ir.ui.view">
        <field name="name">qrbase.report.wizard.form</field>
        <field name="model">qrbase.report.wizard</field>
        <field name="arch" type="xml">
            <form string="QR Reports">
                <header>
                    <button name="action_view_analysis" type="object" string="View Analysis" class="btn-primary"/>
                    <button name="action_print_pdf" type="object" string="Print PDF" class="btn-secondary"/>
                    <button name="action_export_csv" type="object" string="Export CSV" class="btn-secondary"/>
                    <button string="Cancel" class="btn-link" special="cancel"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="report_title" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Filters">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="campaign_id"/>
                            <field name="code_id"/>
                            <field name="allocation_kind"/>
                            <field name="outcome"/>
                            <field name="contact_match_method"/>
                            <field name="existing_contact_filter"/>
                            <field name="newsletter_filter"/>
                            <field name="data_share_filter"/>
                        </group>
                        <group string="Summary">
                            <field name="scan_count" readonly="1"/>
                            <field name="opened_count" readonly="1"/>
                            <field name="registered_count" readonly="1"/>
                            <field name="unique_contact_count" readonly="1"/>
                            <field name="customer_count" readonly="1"/>
                            <field name="prospect_count" readonly="1"/>
                            <field name="sample_count" readonly="1"/>
                            <field name="duplicate_count" readonly="1"/>
                            <field name="newsletter_count" readonly="1"/>
                            <field name="data_consent_count" readonly="1"/>
                            <field name="customer_rate" readonly="1"/>
                            <field name="duplicate_rate" readonly="1"/>
                            <field name="newsletter_rate" readonly="1"/>
                            <field name="data_consent_rate" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status">
                        Use the buttons above to open the chart view, print a PDF, or export a CSV with the filters you selected.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
