<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="qrbase_scan_landing_page" name="QR Scan Landing Page">
        <t t-call="website.layout">
            <t t-set="title">QR Base</t>
            <t t-set="body_class">o_qrbase_landing</t>
            <div t-attf-class="o_qrbase_hero #{theme_class or 'o_qrbase_theme_dark'}">
                <div class="o_qrbase_bg_blob o_qrbase_bg_blob_left"></div>
                <div class="o_qrbase_bg_blob o_qrbase_bg_blob_right"></div>
                <div class="container py-5 position-relative">
                    <div class="row justify-content-center">
                        <div class="col-12 col-lg-10 col-xl-9">
                            <div class="o_qrbase_card">
                                <div class="row g-0 align-items-stretch">
                                    <div class="col-lg-5 o_qrbase_brand_panel">
                                        <div class="o_qrbase_brand">
                                            <div class="o_qrbase_logo_wrap">
                                                <img t-att-src="landing_logo_url or '/qrbase/static/description/icon.svg'" alt="Campaign logo" class="o_qrbase_logo"/>
                                            </div>
                                            <div class="mt-4">
                                                <div class="o_qrbase_kicker">QR tracking</div>
                                                <h1 class="display-5 fw-bold mb-3">Scan. Capture. Convert.</h1>
                                                <p class="lead mb-4">
                                                    This QR code belongs to <strong t-esc="code.campaign_id.name"/>
                                                    and is set up for <span t-esc="code.campaign_id.allocation_kind"/>.
                                                </p>
                                                <div class="o_qrbase_meta">
                                                    <div class="mb-2"><strong>Purpose:</strong> <span t-esc="code.purpose or code.campaign_id.purpose or 'General tracking'"/></div>
                                                    <div class="mb-2" t-if="target_url"><strong>Next step:</strong> <span t-esc="target_url"/></div>
                                                    <div class="mb-0">Use this page to register the contact, capture consent, and let Odoo decide if this is a prospect or a customer.</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="o_qrbase_preview mt-4">
                                            <img t-if="code.qr_image_url" t-att-src="code.qr_image_url" alt="QR Code" class="img-fluid rounded-4 shadow-sm bg-white p-2 o_qrbase_qr_preview"/>
                                        </div>
                                        <div class="o_qrbase_preview_actions mt-3 d-flex flex-wrap gap-2">
                                            <a t-if="target_url" t-att-href="target_url" class="btn btn-outline-light btn-sm">Open destination</a>
                                        </div>
                                    </div>
                                    <div class="col-lg-7 o_qrbase_form_panel">
                                        <div class="p-4 p-lg-5">
                                            <t t-if="contact_message">
                                                <div t-attf-class="alert #{'alert-warning' if contact_is_existing else 'alert-success'}">
                                                    <strong t-if="contact_is_existing">Existing contact found.</strong>
                                                    <strong t-else="">Saved.</strong>
                                                    <div class="mt-1" t-esc="contact_message"/>
                                                    <div t-if="contact_is_existing and contact_status" class="small mt-2">
                                                        Matched by <span class="text-uppercase" t-esc="contact_status"/>.
                                                    </div>
                                                </div>
                                            </t>
                                            <t t-elif="submitted">
                                                <div class="alert alert-success">
                                                    <strong>Saved.</strong> We have captured this scan and updated the customer record.
                                                </div>
                                            </t>

                                            <h2 class="h3 fw-bold mb-2">Tell us about you</h2>
                                            <p class="text-muted mb-4">
                                                Use your own details so we can recognise you, keep your record clean, and continue your journey without duplicates.
                                            </p>

                                            <t t-if="form_error">
                                                <div class="alert alert-danger">
                                                    <strong>Please check the form.</strong>
                                                    <div class="mt-1" t-esc="form_error"/>
                                                </div>
                                            </t>
                                                    <t t-if="otp_pending">
                                                <div class="alert alert-info d-flex flex-column flex-md-row justify-content-between gap-3 align-items-md-center">
                                                    <div>
                                                        <strong>Verification code ready.</strong>
                                                        <div class="mt-1">We show it here because SMS delivery is not connected yet. Copy it or use the fill button.</div>
                                                    </div>
                                                    <div class="display-6 fw-bold font-monospace text-nowrap" id="qrbase_otp_code"><t t-esc="otp_display_code or ''"/></div>
                                                </div>
                                            </t>

                                            <form action="" method="post" class="o_qrbase_form">
                                                <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                                                <input type="hidden" name="scan_id" t-att-value="scan.id"/>

                                                <div class="row g-3">
                                                    <div class="col-12 col-md-3">
                                                        <label class="form-label" for="visitor_title" title="Pick the title you want us to use for you.">Title</label>
                                                        <select class="form-select" id="visitor_title" name="visitor_title" required="required">
                                                            <option value="">Select</option>
                                                            <t t-foreach="title_choices" t-as="choice">
                                                                <option t-att-value="choice[0]" t-att-selected="(form_values.get('visitor_title') or '') == choice[0] and 'selected' or None" t-esc="choice[1]"/>
                                                            </t>
                                                        </select>
                                                    </div>
                                                    <div class="col-12 col-md-4">
                                                        <label class="form-label" for="visitor_first_name" title="This is your first name, exactly as you want us to recognise you.">First name</label>
                                                        <input class="form-control" id="visitor_first_name" type="text" name="visitor_first_name" required="required" t-att-value="form_values.get('visitor_first_name') or ''" placeholder="Your first name"/>
                                                    </div>
                                                    <div class="col-12 col-md-5">
                                                        <label class="form-label" for="visitor_surname" title="This helps us keep your contact clean and easy to match.">Surname</label>
                                                        <input class="form-control" id="visitor_surname" type="text" name="visitor_surname" required="required" t-att-value="form_values.get('visitor_surname') or ''" placeholder="Your surname"/>
                                                    </div>
                                                    <div class="col-12 col-md-4">
                                                        <label class="form-label" for="visitor_gender" title="Choose the gender that best fits you.">Gender</label>
                                                        <select class="form-select" id="visitor_gender" name="visitor_gender" required="required">
                                                            <option value="">Select</option>
                                                            <t t-foreach="gender_choices" t-as="choice">
                                                                <option t-att-value="choice[0]" t-att-selected="(form_values.get('visitor_gender') or '') == choice[0] and 'selected' or None" t-esc="choice[1]"/>
                                                            </t>
                                                        </select>
                                                    </div>
                                                    <div class="col-12 col-md-8">
                                                        <label class="form-label" for="visitor_email" title="We use your email to match your record and confirm your details.">Email</label>
                                                        <input class="form-control" id="visitor_email" type="email" name="visitor_email" required="required" t-att-value="form_values.get('visitor_email') or ''" placeholder="name@example.com"/>
                                                    </div>
                                                    <div class="col-12 col-md-8">
                                                        <label class="form-label" for="visitor_email_confirmation" title="Type your email again so we know we captured it correctly.">Confirm email</label>
                                                        <input class="form-control" id="visitor_email_confirmation" type="email" name="visitor_email_confirmation" required="required" t-att-value="form_values.get('visitor_email_confirmation') or ''" placeholder="name@example.com"/>
                                                    </div>
                                                    <div class="col-12 col-md-12">
                                                        <label class="form-label" for="visitor_mobile_number" title="We keep the country code separate so the number stays clean and easy to read.">Mobile number</label>
                                                        <div class="input-group input-group-lg o_qrbase_mobile_input">
                                                            <select class="form-select o_qrbase_mobile_code" id="visitor_mobile_country_code" name="visitor_mobile_country_code" required="required">
                                                                <t t-foreach="mobile_country_code_choices" t-as="choice">
                                                                    <option t-att-value="choice[0]" t-att-selected="(form_values.get('visitor_mobile_country_code') or '+254') == choice[0] and 'selected' or None" t-esc="choice[1]"/>
                                                                </t>
                                                            </select>
                                                            <input class="form-control" id="visitor_mobile_number" type="text" name="visitor_mobile_number" required="required" t-att-value="form_values.get('visitor_mobile_number') or ''" placeholder="700 000 000"/>
                                                        </div>
                                                        <div class="form-text">
                                                            Country code first, then your number without the leading zero.
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="o_qrbase_consent_box mt-4">
                                                    <div class="d-flex flex-wrap justify-content-between gap-2 align-items-center mb-3">
                                                        <div>
                                                            <div class="fw-semibold">Your consent choices</div>
                                                            <div class="small text-muted">The necessary switch checks the bare minimum terms. Optional choices stay up to you.</div>
                                                        </div>
                                                        <div class="form-check form-switch m-0">
                                                            <input class="form-check-input" type="checkbox" role="switch" name="accept_necessary_terms" id="accept_necessary_terms" data-qrbase-necessary-toggle="1" t-att-checked="form_values.get('accept_necessary_terms') and 'checked' or None"/>
                                                            <label class="form-check-label" for="accept_necessary_terms" title="Use this to accept the necessary terms for registration.">Necessary terms</label>
                                                        </div>
                                                    </div>
                                                    <div class="row g-3">
                                                        <t t-if="consent_terms">
                                                            <t t-foreach="consent_terms" t-as="term">
                                                                <div class="col-12">
                                                                    <div t-attf-class="border rounded-4 p-3 #{'bg-white' if theme_class == 'o_qrbase_theme_light' else 'bg-transparent'}">
                                                                        <div class="form-check form-switch">
                                                                            <input class="form-check-input" type="checkbox" role="switch" t-att-name="'consent_term_%s' % term.id" t-att-id="'consent_term_%s' % term.id" t-att-data-qrbase-required-term="term.necessary and '1' or None" t-att-checked="term.id in (form_values.get('accepted_term_ids') or []) and 'checked' or None"/>
                                                                            <label class="form-check-label fw-semibold" t-att-for="'consent_term_%s' % term.id">
                                                                                <span t-esc="term.name"/>
                                                                                <span t-if="term.necessary" class="badge text-bg-warning ms-2">Necessary</span>
                                                                                <span t-else="" class="badge text-bg-secondary ms-2">Optional</span>
                                                                            </label>
                                                                        </div>
                                                                        <div class="small text-muted mt-2" t-if="term.description">
                                                                            <t t-out="term.description"/>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </t>
                                                        </t>
                                                        <t t-else="">
                                                            <div class="col-12">
                                                                <div class="alert alert-light mb-0">
                                                                    No optional consent items have been configured for this campaign yet.
                                                                </div>
                                                            </div>
                                                        </t>
                                                    </div>
                                                </div>

                                                <div class="o_qrbase_consent_box mt-4" t-if="otp_pending or otp_display_code">
                                                    <div class="d-flex flex-column flex-md-row justify-content-between gap-3 align-items-md-center">
                                                        <div>
                                                            <div class="fw-semibold">Verification code</div>
                                                            <div class="small text-muted">Because SMS delivery is not connected yet, the code is shown here for you to copy or autofill.</div>
                                                        </div>
                                                        <div class="badge rounded-pill text-bg-dark px-3 py-2 font-monospace fs-5" id="qrbase_otp_code_box"><t t-esc="otp_display_code or ''"/></div>
                                                    </div>
                                                    <div class="row g-3 mt-2 align-items-end">
                                                        <div class="col-12 col-md-7">
                                                            <label class="form-label" for="otp_code">Enter the code</label>
                                                            <input class="form-control form-control-lg" id="otp_code" type="text" name="otp_code" autocomplete="one-time-code" t-att-value="form_values.get('otp_code') or ''" placeholder="123456"/>
                                                        </div>
                                                        <div class="col-12 col-md-5">
                                                            <button type="button" class="btn btn-outline-light btn-lg w-100" data-qrbase-otp-fill="1">Auto-fill code</button>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="d-flex flex-wrap gap-2 mt-4">
                                                    <button type="submit" class="btn btn-dark btn-lg px-4">Continue</button>
                                                    <a t-if="target_url" t-att-href="target_url" class="btn btn-outline-secondary btn-lg px-4">Go to your next step</a>
                                                </div>
                                            </form>

                                            <script type="text/javascript">
                                                (function () {
                                                    function initQrbaseLanding() {
                                                    var necessaryToggle = document.querySelector('[data-qrbase-necessary-toggle]');
                                                    var requiredTerms = Array.prototype.slice.call(document.querySelectorAll('[data-qrbase-required-term="1"]'));
                                                    var otpFillButton = document.querySelector('[data-qrbase-otp-fill="1"]');
                                                    var otpInput = document.getElementById('otp_code');
                                                    var otpCode = document.getElementById('qrbase_otp_code_box');

                                                    function syncNecessaryState() {
                                                        if (!necessaryToggle || !requiredTerms.length) {
                                                            return;
                                                        }
                                                        requiredTerms.forEach(function (checkbox) {
                                                            checkbox.checked = necessaryToggle.checked;
                                                        });
                                                    }

                                                    function refreshNecessaryToggle() {
                                                        if (!necessaryToggle || !requiredTerms.length) {
                                                            return;
                                                        }
                                                        necessaryToggle.checked = requiredTerms.every(function (checkbox) {
                                                            return checkbox.checked;
                                                        });
                                                    }

                                                    if (necessaryToggle) {
                                                        necessaryToggle.addEventListener('change', syncNecessaryState);
                                                        requiredTerms.forEach(function (checkbox) {
                                                            checkbox.addEventListener('change', refreshNecessaryToggle);
                                                        });
                                                        syncNecessaryState();
                                                        refreshNecessaryToggle();
                                                    }

                                                    if (otpFillButton &amp;&amp; otpInput &amp;&amp; otpCode) {
                                                        otpFillButton.addEventListener('click', function () {
                                                            otpInput.value = (otpCode.textContent || '').trim();
                                                            otpInput.focus();
                                                        });
                                                    }
                                                    }

                                                    if (document.readyState === 'loading') {
                                                        document.addEventListener('DOMContentLoaded', initQrbaseLanding);
                                                    } else {
                                                        initQrbaseLanding();
                                                    }
                                                })();
                                            </script>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <style>
                .o_qrbase_hero {
                position: relative;
                overflow: hidden;
                min-height: 100vh;
                color: #f8fafc;
                }
                .o_qrbase_theme_dark {
                background:
                radial-gradient(circle at top left, rgba(255, 207, 92, 0.35), transparent 34%),
                radial-gradient(circle at bottom right, rgba(14, 28, 58, 0.92), rgba(5, 10, 22, 0.98));
                }
                .o_qrbase_theme_light {
                background:
                radial-gradient(circle at top left, rgba(255, 238, 180, 0.95), transparent 32%),
                radial-gradient(circle at bottom right, rgba(226, 233, 241, 0.96), rgba(244, 247, 251, 1));
                color: #0f172a;
                }
                .o_qrbase_theme_light .o_qrbase_card {
                background: rgba(255, 255, 255, 0.9);
                border-color: rgba(15, 23, 42, 0.08);
                }
                .o_qrbase_theme_light .o_qrbase_brand_panel {
                background: linear-gradient(180deg, rgba(255, 255, 255, 0.85), rgba(248, 250, 252, 0.9));
                color: #0f172a;
                border-right-color: rgba(15, 23, 42, 0.08);
                }
                .o_qrbase_theme_light .o_qrbase_meta,
                .o_qrbase_theme_light .text-muted {
                color: #475569 !important;
                }
                .o_qrbase_theme_light .o_qrbase_kicker {
                color: #9a6700;
                }
                .o_qrbase_theme_light .btn-outline-light {
                color: #0f172a;
                border-color: rgba(15, 23, 42, 0.25);
                }
                .o_qrbase_bg_blob {
                position: absolute;
                width: 26rem;
                height: 26rem;
                border-radius: 999px;
                filter: blur(30px);
                opacity: 0.35;
                }
                .o_qrbase_bg_blob_left {
                top: -8rem;
                left: -8rem;
                background: #f7c948;
                }
                .o_qrbase_bg_blob_right {
                bottom: -10rem;
                right: -8rem;
                background: #66d9ef;
                }
                .o_qrbase_card {
                border: 1px solid rgba(255, 255, 255, 0.12);
                border-radius: 2rem;
                overflow: hidden;
                backdrop-filter: blur(18px);
                background: rgba(9, 16, 32, 0.82);
                box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
                }
                .o_qrbase_brand_panel {
                background: linear-gradient(180deg, rgba(255, 215, 90, 0.14), rgba(255, 255, 255, 0.02));
                padding: 2rem;
                border-right: 1px solid rgba(255, 255, 255, 0.08);
                }
                .o_qrbase_form_panel {
                background: rgba(255, 255, 255, 0.03);
                }
                .o_qrbase_logo_wrap {
                width: 6rem;
                height: 6rem;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 1.6rem;
                background: rgba(255, 255, 255, 0.92);
                box-shadow: 0 14px 30px rgba(15, 23, 42, 0.12);
                }
                .o_qrbase_logo {
                max-width: 4.8rem;
                max-height: 4.8rem;
                object-fit: contain;
                }
                .o_qrbase_kicker {
                display: inline-block;
                text-transform: uppercase;
                letter-spacing: 0.18em;
                font-size: 0.72rem;
                color: #ffd76a;
                margin-bottom: 0.75rem;
                }
                .o_qrbase_meta {
                font-size: 0.95rem;
                color: rgba(255, 255, 255, 0.82);
                }
                .o_qrbase_qr_preview {
                width: min(100%, 22rem);
                max-width: 22rem;
                padding: 0.75rem !important;
                }
                .o_qrbase_form .form-control,
                .o_qrbase_form .form-select {
                background: rgba(255, 255, 255, 0.96);
                border-radius: 1rem;
                border: 0;
                min-height: 3.1rem;
                }
                .o_qrbase_form .form-control:focus,
                .o_qrbase_form .form-select:focus {
                box-shadow: 0 0 0 0.2rem rgba(255, 215, 106, 0.25);
                }
                .o_qrbase_form textarea.form-control {
                min-height: 8rem;
                }
                .o_qrbase_consent_box {
                border: 1px solid rgba(255, 255, 255, 0.1);
                border-radius: 1.25rem;
                padding: 1rem 1rem 0.25rem;
                background: rgba(255, 255, 255, 0.03);
                }
                .o_qrbase_mobile_input {
                overflow: hidden;
                border-radius: 1rem;
                }
                .o_qrbase_mobile_code {
                max-width: 14rem;
                flex: 0 0 14rem;
                }
                .o_qrbase_theme_light .o_qrbase_consent_box {
                border-color: rgba(15, 23, 42, 0.1);
                background: rgba(255, 255, 255, 0.78);
                }
                .o_qrbase_theme_light .o_qrbase_form .form-control,
                .o_qrbase_theme_light .o_qrbase_form .form-select {
                background: rgba(255, 255, 255, 0.98);
                color: #0f172a;
                }
                .o_qrbase_theme_light .o_qrbase_card,
                .o_qrbase_theme_light .o_qrbase_consent_box {
                backdrop-filter: blur(10px);
                }
            </style>
        </t>
    </template>
</odoo>
